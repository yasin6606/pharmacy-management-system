# Copy to infrastructure/.env and adjust before `docker compose up`

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pharmacy_db

# --- Backend ---
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
TITAK_API_KEY=
TYPEORM_SYNCHRONIZE=false

# Optional: shared rate-limit store (recommended when scaling backend replicas)
REDIS_URL=redis://redis:6379

# Public URL of the site (used by CORS if you enable origin checks later)
CORS_ORIGIN=http://localhost

# Host port for nginx (change if 80 is taken)
HTTP_PORT=80
