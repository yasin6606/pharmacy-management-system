# Copy to infrastructure/.env and adjust before `docker compose up`

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pharmacy_db

# --- Backend ---
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=8h
TITAK_API_KEY=

# First deploy only: set true once to create tables, then false + use migrations
TYPEORM_SYNCHRONIZE=true

# Shared rate-limit store (Compose Redis service)
REDIS_URL=redis://redis:6379

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost,http://localhost:3000

# Host port for nginx
HTTP_PORT=80
